# Frontend build-time settings (copy to frontend/.env for local overrides).

# Backend base URL for a split deployment (e.g. frontend on Vercel, backend elsewhere).
# Leave unset locally: the Vite dev server proxies /api to http://127.0.0.1:8000.
# When set, also add this frontend's origin to CORS_ORIGINS in the backend's .env.
# VITE_API_BASE=https://your-backend.example.com

# Dev-server proxy target (only used by `npm run dev`).
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional PostHog analytics (disabled unless a key is set).
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
