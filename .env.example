# ── LLM (optional for the Knowledge Base, required for the CEO twin) ─────────
# Gemini API key (https://aistudio.google.com/apikey).
# Without it the Knowledge Base still works: rule-based triple extraction,
# extractive topic summaries and quote-only, cited answers.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Knowledge Base (all optional; defaults shown) ─────────────────────────────
# KB_LLM=auto                      # auto | off  (off = never call Gemini from the KB)
# KB_GEN_MODEL=gemini-3.5-flash    # answers
# KB_FAST_MODEL=gemini-3.5-flash-lite  # extraction, topic summaries, routing
# KB_DATA_DIR=data/kb              # uploads + SQLite graph + Chroma index
# KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # or "hash" for offline
# KB_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2      # or "none"
# KB_CHUNK_SIZE=900
# KB_CHUNK_OVERLAP=150
# KB_MAX_UPLOAD_MB=20
# KB_MAX_FILES=20
# KB_EXTRACTION_CONCURRENCY=4
# KB_COMMUNITY_RESOLUTION=1.2      # higher = more, smaller topic communities

# ── Accounts, workspaces and placement (all optional; defaults shown) ─────────
# HYPNEXIS_DATA_DIR=data           # platform DB (data/platform/hypnexis.db) + per-workspace stores
# HYPNEXIS_ADMIN_EMAILS=           # comma-separated; these accounts become administrators
#                                  # (or: python -m backend.auth.cli make-admin you@example.com)
# HYPNEXIS_REGISTRATION=open       # open | closed (closed = no self-service sign-up)
# KB_SHARED_WRITE=admin            # who may change the shared demo graph: admin | authenticated | public
# AUTH_SESSION_HOURS=12            # session length without "keep me signed in"
# AUTH_REMEMBER_DAYS=30            # session length with "keep me signed in"
# AUTH_COOKIE_SECURE=auto          # auto (Secure over HTTPS) | true | false
# AUTH_COOKIE_SAMESITE=lax         # lax | strict | none (none needs HTTPS; use for a frontend on another domain)
# HYPNEXIS_MAX_OPEN_KBS=16         # workspace knowledge bases kept open at once (LRU)
# PLACEMENT_MAX_UPLOAD_MB=10       # CSV/XLSX import size limit
# PLACEMENT_MAX_ROWS=50000         # rows per import

# ── Graph store: Neo4j (primary) ──────────────────────────────────────────────
# Start a local Neo4j with:  docker compose up -d neo4j   (Browser: http://localhost:7474)
# KB_GRAPH_STORE: neo4j  = Neo4j required (startup fails with a clear error if unreachable)
#                 auto   = Neo4j when NEO4J_URI is reachable, else local SQLite + NetworkX (warned in the UI)
#                 sqlite = local SQLite + NetworkX only (offline development)
KB_GRAPH_STORE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# also used by docker-compose.yml for the local container (min. 8 characters)
NEO4J_PASSWORD=change-me-local-dev
# NEO4J_DATABASE=neo4j
# NEO4J_NAMESPACE=default          # shared corpus; each workspace KB uses "<namespace>.ws-<workspace id>"

# ── Server ────────────────────────────────────────────────────────────────────
# WARMUP_LEGACY_CEO=0              # 1 = preload the CEO twin's models at startup
# Origins allowed to call the API besides localhost dev servers (comma-separated),
# e.g. your deployed frontend: CORS_ORIGINS=https://your-frontend.vercel.app
# CORS_ORIGINS=
